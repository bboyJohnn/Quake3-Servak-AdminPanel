# Quake III Web Panel settings. Copy this file to .env next to app.py and fill in the REQUIRED part:
#   cp .env.example .env && chmod 600 .env
# A value may refer to a key above it: ${Q3_HOME}/baseq3. Text after " #" is a comment.
# Check everything with:  python3 app.py --check

# ============================================================== REQUIRED

# The server's home folder (fs_homepath): the folder that holds baseq3/ with server.cfg,
# games.log and qconsole.log. For ioquake3 it is ~/.q3a of the user the server runs as,
# or whatever you pass as +set fs_homepath.
Q3_HOME=/home/quake/.q3a

# Folders with pak0.pk3 and your other pk3 files (fs_basepath/baseq3), separated by ":".
# The mod folder inside Q3_HOME is added automatically. The panel reads the list of maps,
# map pictures, map descriptions and the Quake III look (backgrounds, sounds, music) from them.
PAK_DIRS=/opt/ioquake3/baseq3

# Panel login password (scrypt hash) and the key that signs login cookies.
# Do not write them by hand — run:  python3 app.py --password
PANEL_PASSWORD_HASH=
PANEL_SECRET=

# ============================================================== GAME SERVER — where the panel connects

# Address and port of the game server for getstatus and rcon (UDP). Same machine: 127.0.0.1.
Q3_HOST=127.0.0.1
Q3_PORT=27960
# The rcon password is read from server.cfg (seta rconpassword "…"). Set it here only if the
# server gets it some other way, e.g. on its command line.
RCON_PASSWORD=

# ============================================================== NETWORK — where the panel listens

# 127.0.0.1 = only this machine (open it through an SSH tunnel or a reverse proxy).
PANEL_HOST=127.0.0.1
PANEL_PORT=8091
# Who may connect at all (before the password): addresses and networks, comma separated.
# Behind nginx on the same machine keep 127.0.0.1. For a home network: 127.0.0.1,::1,192.168.0.0/24
PANEL_ALLOWED_PEERS=127.0.0.1,::1

# ============================================================== LOOK

PANEL_TITLE=                     # name in the menu and on the login screen; empty = the server's sv_hostname
PANEL_ADDRESS=                   # address for players, shown on the Overview, e.g. q3.example.com:27960

# ============================================================== OPTIONAL OVERRIDES
# Leave empty to use the defaults shown.

Q3_GAME=                         # baseq3 — the mod folder inside Q3_HOME
SERVER_CFG=                      # ${Q3_HOME}/baseq3/server.cfg
GAMES_LOG=                       # ${Q3_HOME}/baseq3/games.log (seta g_log "games.log")
CONSOLE_LOG=                     # ${Q3_HOME}/baseq3/qconsole.log (seta logfile 1)

# Panel's own data: statistics database, audit log, copies of server.cfg.
PANEL_DATA=                      # ./data
# Country by IP: a GeoLite2-Country or DB-IP Country Lite .mmdb file. Without it countries are not shown.
GEOIP_DB=                        # ./data/GeoLite2-Country.mmdb or ./data/dbip-country-lite.mmdb

# Statistics backups: a copy of data/panel.db (statistics, player visits, audit log) once a day and from the
# Backup tab, kept for this many days; download, upload and restore on the same tab. 0 or empty - off.
BACKUP_DAYS=
BACKUP_DIR=                      # ${PANEL_DATA}/backups
